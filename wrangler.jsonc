{
  // Cloudflare Workers static-assets config for this Vite SPA.
  // Build: `pnpm run build` -> ./dist ; Deploy: `npx wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifetrinket",
  "compatibility_date": "2025-01-01",
  "assets": {
    // Serve the built site directly; no Worker script needed.
    "directory": "./dist",
    // Serve /index.html for unknown paths so client-side routing / deep
    // links work. `public/_redirects` and `public/_headers` are also
    // honored by Workers static assets.
    "not_found_handling": "single-page-application"
  }
}
